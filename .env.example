# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...          # server-side ONLY
SUPABASE_ANON_KEY=eyJhbGciOi...                  # front-end
# Conexión directa (solo para scripts/push-schema.ts)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── API ─────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Seguridad ───────────────────────────────────────────────────────────────
# Pimienta global aplicada al hash SHA-256 de las API Keys
API_KEY_PEPPER=cambia-esto-por-un-secreto-largo-y-aleatorio

# ── MCP ─────────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=erp-compras-almacen
# API Key con la que el cliente MCP (Claude, n8n, etc.) opera contra el core
MCP_API_KEY=sk_live_...

# ── Worker de tareas periódicas (npm run worker) ────────────────────────────
JOBS_INTERVALO_MIN=5
JOBS_REORDEN_HORAS=12
# Destino de los eventos de dominio (pedido.validado, requisicion.creada, ...)
# WEBHOOK_URL=https://n8n.tuempresa.mx/webhook/erp
# WEBHOOK_SECRET=secreto-para-firmar-hmac-sha256
