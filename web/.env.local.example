# URL del backend Fastify (nunca se expone al navegador: solo la usa el BFF).
API_URL=http://localhost:3000

# Credencial que el BFF adjunta cuando la petición NO trae `x-api-key`.
#
# Este módulo no tiene login: en producción la aplicación principal inyecta
# `x-api-key` (y opcionalmente `x-user-role`) en cada petición, y esta variable
# se deja vacía. Sirve para correr el módulo suelto en desarrollo.
API_KEY=sk_live_...
